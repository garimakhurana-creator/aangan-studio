# Copy to .env (local) and add the same values in Vercel → Settings → Environment Variables.
# Never commit .env.

# --- Gemini: call extraction ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview

# --- Vaani: voice agent ---
VAANI_API_KEY=
VAANI_WEBHOOK_SECRET=            # any long random string; goes in the webhook URL ?key=...

# --- Neon Postgres (falls back to data/store.json when unset) ---
DATABASE_URL=

# --- HubSpot private app token (contacts + deals read/write) ---
HUBSPOT_ACCESS_TOKEN=

# --- Calendly: single-use booking links ---
CALENDLY_TOKEN=
CALENDLY_EVENT_TYPE_URI=         # https://api.calendly.com/event_types/...
CALENDLY_SITE_VISIT_EVENT_TYPE_URI=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=                     # e.g. Aangan Studio <desk@yourdomain>; default onboarding@resend.dev
DESIGNER_EMAIL=                  # used when config/team.json has no designers
EMAIL_OVERRIDE_TO=               # test mode: every email goes here instead

# --- Telegram: Nikhil's ops alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard ---
# DASHBOARD_PASSWORD=            # optional: set to lock the dashboard
PUBLIC_BASE_URL=                 # e.g. https://aangan-studio.vercel.app (for accept links)
CRON_SECRET=
